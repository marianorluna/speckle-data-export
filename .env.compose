# Interpolation-only file for Docker Compose (NO secrets, NO bcrypt `$` hashes).
# Runtime secrets: mount `.env` via docker-compose.local.yml, or set them in Coolify.
#
# Local:
#   docker compose --env-file .env.compose -f docker-compose.yml -f docker-compose.local.yml up --build
#
# Coolify:
#   docker compose --env-file .env.compose -f docker-compose.yml up --build
#   (and configure env vars in the Coolify UI)
