# Copia a `.env`. No commitees `.env` (esta en .gitignore).

# ─── Aplicacion ──────────────────────────────────────────────────────────────
# NODE_ENV=development
# API_PORT=8000
# WEB_PORT=5173
# APP_URL=http://localhost:5173

# ─── Base de datos ───────────────────────────────────────────────────────────
# SQLite local (sin configuracion adicional). Para Postgres en prod:
# DATABASE_URL=sqlite+aiosqlite:///./data/bim.db
# Docker Compose fuerza sqlite+aiosqlite:////data/bim.db (volumen api_data).

# ─── Autenticacion (JWT) ─────────────────────────────────────────────────────
# JWT_SECRET=cambia-esto-en-produccion-por-un-valor-largo-y-aleatorio
# JWT_EXPIRES_HOURS=24
# ADMIN_EMAIL=admin@ejemplo.com
# ADMIN_PASSWORD_HASH=  # Generar con: python -c "import bcrypt; print(bcrypt.hashpw(b'tu-password', bcrypt.gensalt(rounds=12)).decode())"
# Guest (demo LinkedIn). Password en claro solo en README / login UI; aqui SOLO el hash.
# GUEST_EMAIL=invitado@ejemplo.com
# GUEST_PASSWORD_HASH=
# Guest extendido (privado; mas cuota). Password en claro NO en README; aqui SOLO el hash.
# GUEST_EXTENDED_EMAIL=invitado-extendido@ejemplo.com
# GUEST_EXTENDED_PASSWORD_HASH=

# ─── Speckle ─────────────────────────────────────────────────────────────────
# PAT (Personal Access Token), NO el "Share token" del dialogo Share this model.
# Como crearlo y scopes minimos: docs/onboarding.md → Speckle (token y project id)
# SPECKLE_TOKEN=          # solo servidor (ingest / poller); NUNCA al frontend
# SPECKLE_VIEWER_TOKEN=   # PAT de solo lectura para /api/speckle/viewer-config (si vacio, usa SPECKLE_TOKEN)
# SPECKLE_SERVER_URL=https://app.speckle.systems   # debe coincidir con la URL del proyecto
# SPECKLE_STREAM_ID=   # Project id: https://app.speckle.systems/projects/<ESTE_ID>/...
# SPECKLE_BRANCH_NAME=main   # modelo Speckle (branch). Carpetas: structure/snowdon-towers-r27
# SPECKLE_POLL_INTERVAL_SECONDS=30
# El visor 3D obtiene server/stream/token/commit via GET /api/speckle/viewer-config (JWT).
# El commit es el ultimo de SPECKLE_BRANCH_NAME (no otro modelo del proyecto).

# ─── IA (DeepSeek via OpenRouter) ────────────────────────────────────────────
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-chat
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# CHAT_GUEST_DAILY_LIMIT=3   # preguntas billables/dia/IP para rol guest (admin exento)
# CHAT_GUEST_EXTENDED_DAILY_LIMIT=50  # preguntas billables/dia/user para guest_extended
# Billable = respuesta query con element_ids (boton Ver en visor).

# ─── CORS ────────────────────────────────────────────────────────────────────
# Local Vite: http://localhost:5173 | Docker local (nginx): http://localhost:8080
# Coolify: https://bim-dashboard.demo.marianorluna.com (same-origin vía proxy; igual conviene listarlo)
# CORS_ORIGINS=http://localhost:5173,http://localhost:8080,https://bim-dashboard.demo.marianorluna.com

# ─── Docker Compose (local) ──────────────────────────────────────────────────
# No uses `env_file:` de Compose con hashes bcrypt: el `$` se interpreta y rompe el login.
# Monta `.env` con docker-compose.local.yml (ver README → Docker local).
# Coolify panel: escribe cada `$` del hash como `$$` (Compose interpola el .env del deploy).

# ─── WebSocket / pyRevit ─────────────────────────────────────────────────────
# REVIT_API_KEY=cambia-esto-clave-local-para-pyrevit
# Debe coincidir con API_KEY en apps/api/scripts/revit_push/config.py (pushbutton).
# WS_HEARTBEAT_INTERVAL=30
# Reconexion frontend (prompt 09): backoff exponencial 1s, 2s, 4s, … max 30s.
