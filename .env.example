# Copia a `.env`. No commitees `.env` (esta en .gitignore).

# ─── Aplicacion ──────────────────────────────────────────────────────────────
# NODE_ENV=development
# API_PORT=8000
# WEB_PORT=5173
# APP_URL=http://localhost:5173

# ─── Base de datos ───────────────────────────────────────────────────────────
# SQLite local (sin configuracion adicional). Para Postgres en prod:
# DATABASE_URL=sqlite+aiosqlite:///./data/bim.db

# ─── Autenticacion (JWT) ─────────────────────────────────────────────────────
# JWT_SECRET=cambia-esto-en-produccion-por-un-valor-largo-y-aleatorio
# JWT_EXPIRES_HOURS=24
# ADMIN_EMAIL=admin@ejemplo.com
# ADMIN_PASSWORD_HASH=  # Generar con: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('tu-password'))"

# ─── Speckle ─────────────────────────────────────────────────────────────────
# SPECKLE_TOKEN=      # Token de acceso personal desde https://speckle.xyz/profile
# SPECKLE_SERVER_URL=https://speckle.xyz
# SPECKLE_STREAM_ID=  # ID del stream de Revit
# SPECKLE_POLL_INTERVAL_SECONDS=30

# ─── IA (DeepSeek via OpenRouter) ────────────────────────────────────────────
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-chat
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ─── CORS ────────────────────────────────────────────────────────────────────
# CORS_ORIGINS=http://localhost:5173,https://tudominio.com

# ─── WebSocket ───────────────────────────────────────────────────────────────
# WS_HEARTBEAT_INTERVAL=30